# =============================================================================
# Agentic AI Loan Approval System — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- AWS Bedrock (Claude Sonnet) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5

# --- FastAPI Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# --- FastMCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- MCP Client (Orchestrator -> MCP Server) ---
MCP_CLIENT_BASE_URL=http://localhost:8080
MCP_CLIENT_TIMEOUT_SECONDS=10
MCP_CLIENT_MAX_RETRIES=2

# --- Streamlit UI ---
STREAMLIT_PORT=8501
FASTAPI_BASE_URL=http://localhost:8000

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=loan_policy_docs

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Audit ---
AUDIT_LOG_DIR=./audit/logs
